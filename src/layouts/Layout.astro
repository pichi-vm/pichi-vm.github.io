---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
import "../styles/global.css";

const title = "pichi-vm — The container workflow, for real virtual machines";
const description =
  "pichi-vm brings the container workflow to full virtual machines: one portable image that boots identically on your laptop, in the cloud, or on bare metal, with real isolation and a small, fast boot chain with a deterministic launch measurement.";
const socialDescription =
  "One portable image that boots identically on your laptop, in the cloud, or on bare metal, with real isolation and a small, fast boot chain with a deterministic launch measurement.";

// Absolute URLs for canonical + social tags, derived from `site` in astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/pichi-logo.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/pichi-logo.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
