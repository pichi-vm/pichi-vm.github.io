---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
import "../styles/global.css";

// Per-page <head> metadata. Defaults describe the site as a whole so a simple
// page can render <Layout> with no props; pages that want their own title /
// social card pass these in. socialDescription defaults to `description`.
interface Props {
  title?: string;
  description?: string;
  socialDescription?: string;
  ogImage?: string;
}

const {
  title = "Pichi — Container workflow. VM isolation.",
  description = "Build, distribute, and run Linux virtual machines as OCI images. See the Pichi workflow in a real terminal demo and explore the image format.",
  socialDescription = description,
  ogImage = "/pichi-logo.png",
} = Astro.props;

// Absolute URLs for canonical + social tags, derived from `site` in astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/pichi-logo.svg" />
    <link rel="icon" type="image/png" href="/pichi-logo.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
