---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import { landing } from "../content/schema";
---

<Layout
  title="Page not found — Pichi"
  description="This page could not be found. Return to Pichi to explore the project and watch the demo."
>
  <TopBar
    links={landing.navigation.map((link) => ({
      ...link,
      href: link.href.startsWith("#") ? `/${link.href}` : link.href,
    }))}
  />
  <main id="main" class="wrap notfound">
    <img
      src="/pichi-logo.svg"
      width="180"
      height="180"
      alt="Pichi the armadillo"
    />
    <p class="eyebrow">404 / A wrong turn</p>
    <h1>Nothing in this shell.</h1>
    <p>That page doesn’t exist. Let’s get you back to Pichi.</p>
    <a class="btn" href="/">
      Back to home <span aria-hidden="true">↗</span>
    </a>
  </main>
</Layout>
<style>
  .notfound {
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding-block: 3rem;
    text-align: center;
  }
  .notfound img {
    width: 180px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .notfound > p:not(.eyebrow) {
    color: var(--muted);
  }
</style>
