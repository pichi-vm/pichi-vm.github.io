---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
// GitHub Pages serves this as /404.html for any unmatched path.
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="notfound">
    <img
      class="logo"
      src="/pichi-logo.png"
      width="88"
      height="88"
      alt="pichi-vm mascot"
    />
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="sub">That page doesn't exist — or hasn't been built yet.</p>
    <a class="btn btn-primary" href="/">
      Back to home
    </a>
  </section>
</Layout>

<style>
  .notfound {
    text-align: center;
    padding: 5rem 0;
  }
  .logo {
    width: 88px;
    height: 88px;
    margin: 0 auto 1.5rem;
    display: block;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .notfound h1 {
    font-size: 1.8rem;
    color: #fff;
    margin: 0.25rem 0 0.75rem;
  }
  .sub {
    color: var(--muted);
    margin-bottom: 2rem;
  }
</style>
