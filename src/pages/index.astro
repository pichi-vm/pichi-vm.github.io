---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
//
// The landing page: the one place that reads content and wires it into the
// section components. Data slices come from landing.yaml and prose paragraphs
// from prose.yaml (both via the schema); each prose line is rendered into a
// section's named slot with set:html. A new page follows this same shape —
// import the sections it reuses, hand them their data + prose.
import Layout from "../layouts/Layout.astro";
import { landing, prose } from "../content/schema";

// Components are named for the layout they render; this page maps each content
// slice onto one. e.g. the "problem" content renders as a CardGrid, "why" as a
// FeatureGrid — a different page could render its own content through the same
// components.
import UnderConstructionBanner from "../components/UnderConstructionBanner.astro";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import StepsTerminal from "../components/StepsTerminal.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import Ctas from "../components/Ctas.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <UnderConstructionBanner />
  <Hero hero={landing.hero} ctas={landing.ctas}>
    <p slot="sub" set:html={prose.heroSub} />
  </Hero>
  <ComparisonTable content={landing.comparison}>
    <p slot="intro" set:html={prose.comparisonIntro} />
    <p slot="caveat" set:html={prose.comparisonCaveat} />
    <a slot="link" href="/security#compare">
      Compare the security boundary →
    </a>
  </ComparisonTable>
  <FeatureGrid content={landing.why} />
  <StepsTerminal content={landing.howItWorks}>
    <p slot="intro" set:html={prose.howItWorksIntro} />
    <p slot="caption" set:html={prose.howItWorksCaption} />
  </StepsTerminal>
  <section class="section explore-security">
    <Ctas ctas={landing.exploreSecurity} />
  </section>
  <Footer footer={landing.footer} ctas={landing.ctas} />
</Layout>

<style>
  /* Center the single "trust model" link that bridges to the security page. */
  .explore-security :global(.cta-row) {
    justify-content: center;
  }
</style>
