// SPDX-License-Identifier: Apache-2.0
import Layout from "../layouts/Layout.astro";
import { landing, prose } from "../content/schema";
import TopBar from "../components/TopBar.astro";
import Hero from "../components/Hero.astro";
import TerminalRecording from "../components/TerminalRecording.astro";
import LayerStack from "../components/LayerStack.astro";
import SplitPanel from "../components/SplitPanel.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <TopBar links={landing.navigation} />
  <main id="main">
    <Hero content={landing.hero}>
      <p slot="intro">{prose.heroSub}</p>
    </Hero>
    <TerminalRecording content={landing.demo}>
      <p slot="intro">{prose.demoIntro}</p>
      <p slot="caption">{prose.demoCaption}</p>
    </TerminalRecording>
    <LayerStack content={landing.image}>
      <p slot="intro">{prose.imageIntro}</p>
    </LayerStack>
    <SplitPanel content={landing.status}>
      <p slot="intro">{prose.statusIntro}</p>
      <p slot="note">{prose.integrityNote}</p>
    </SplitPanel>
  </main>
  <Footer content={landing.footer}>
    <p slot="intro">{prose.footerIntro}</p>
  </Footer>
</Layout>
