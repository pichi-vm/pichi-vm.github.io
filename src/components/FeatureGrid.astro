---
// ── Feature grid: title + a 2-up grid of heading/body/(note) cards ──
import type { FeatureGridContent } from "../content/schema";

interface Props {
  content: FeatureGridContent;
}

const { content } = Astro.props;
---

<section class="section">
  <div class="section-title">{content.title}</div>
  <div class="grid grid-2">
    {content.props.map((prop) => (
      <div class="prop">
        <h3>{prop.heading}</h3>
        <p>
          {prop.body}
          {prop.note && <span class="note">{prop.note}</span>}
        </p>
      </div>
    ))}
  </div>
</section>

<style>
  .prop {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.35rem 1.5rem;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  .prop:hover {
    transform: translateY(-2px);
    border-color: var(--green);
  }
  @media (prefers-reduced-motion: reduce) {
    .prop {
      transition: border-color 0.15s ease;
    }
    .prop:hover {
      transform: none;
    }
  }
  .prop h3 {
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .prop p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }
  .prop .note {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.85;
  }
</style>
