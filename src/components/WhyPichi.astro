---
// ── Why pichi ─────────────────────────────────────────
import { landing } from "../content/schema";

const { why } = landing;
---

<section class="section">
  <div class="section-title">{why.title}</div>
  <div class="grid grid-2">
    {why.props.map((prop) => (
      <div class="prop">
        <h3>{prop.heading}</h3>
        <p>
          {prop.body}
          {prop.note && <span class="note">{prop.note}</span>}
        </p>
      </div>
    ))}
  </div>
</section>

<style>
  .prop {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.35rem 1.5rem;
  }
  .prop h3 {
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .prop p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }
  .prop .note {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.85;
  }
</style>
