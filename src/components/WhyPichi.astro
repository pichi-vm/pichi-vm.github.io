---
// ── Why pichi ─────────────────────────────────────────
import data from "../content/landing.yaml";

const { why } = data;
---

<section class="section">
  <div class="section-title">{why.title}</div>
  <div class="props">
    {
      why.props.map((prop) => (
        <div class="prop">
          <h3>{prop.heading}</h3>
          <p>
            {prop.body}
            {prop.note && <span class="note">{prop.note}</span>}
          </p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .props {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .prop {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.35rem 1.5rem;
  }
  .prop h3 {
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }
  .prop p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }
  .prop .note {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.85;
  }
</style>
