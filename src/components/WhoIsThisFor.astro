---
// ── Who is this for ───────────────────────────────────
import data from "../content/landing.yaml";

const { who } = data;
---

<section class="section">
  <div class="section-title">{who.title}</div>
  <div class="who">
    {
      who.columns.map((col) => (
        <div class="whocol">
          <h3>{col.heading}</h3>
          <ul>
            {col.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .who {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .whocol {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.4rem 1.5rem;
  }
  .whocol h3 {
    font-size: 1rem;
    color: #fff;
    margin-bottom: 0.6rem;
  }
  .whocol ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .whocol li {
    font-size: 0.9rem;
    color: var(--muted);
    padding-left: 1.2rem;
    position: relative;
    margin-bottom: 0.4rem;
  }
  .whocol li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
