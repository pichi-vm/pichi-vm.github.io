---
// ── Steps + fanout: heading + intro slot + numbered steps + a fan-out diagram ──
// Intro comes in via the "intro" slot so the page owns the wording.
import type { StepsFanoutContent } from "../content/schema";
import Steps from "./Steps.astro";

interface Props {
  content: StepsFanoutContent;
}

const { content } = Astro.props;
---

<section class="section">
  <h2 class="h">{content.heading}</h2>
  <div class="section-desc hiw-intro">
    <slot name="intro" />
  </div>
  <Steps steps={content.steps} />
  <div class="fanout">
    <div class="fan-img">{content.fanout.image}</div>
    <div class="fan-arrows" aria-hidden="true">
      ↙ ↓ ↘
    </div>
    <div class="fan-targets">
      {content.fanout.targets.map((t) => (
        <span class="fan-t">{t}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .hiw-intro {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .fanout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .fan-img {
    font-family: var(--font-mono);
    font-weight: 700;
    color: #fff;
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
  }
  .fan-arrows {
    color: var(--muted);
    font-size: 1.2rem;
    letter-spacing: 0.5rem;
  }
  .fan-targets {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .fan-t {
    font-size: 0.85rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
  }
</style>
