---
// ── Comparison table: title + a per-column comparison table + caveat slot ──
// Caveat comes in via the "caveat" slot so the page owns the wording.
import type { ComparisonTableContent } from "../content/schema";

interface Props {
  content: ComparisonTableContent;
}

const { content } = Astro.props;
const { columns, rows } = content;
---

<section class="section">
  <div class="section-title">{content.title}</div>
  <div class="tbl-wrap">
    <table>
      <thead>
        <tr>
          <th></th>
          {columns.map((col) => (
            <th class:list={[{ pichi: col.pichi }]}>{col.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th>{row.label}</th>
            {columns.map((col) => (
              <td class:list={[{ pichi: col.pichi }]}>{row[col.key]}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="caveat">
    <slot name="caveat" />
  </div>
</section>

<style>
  .tbl-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.88rem;
    min-width: 34rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  thead th {
    background: var(--surface);
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  thead th.pichi {
    color: var(--green);
  }
  tbody th {
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
  }
  td.pichi {
    color: #fff;
    background: linear-gradient(180deg, rgba(63, 185, 80, 0.05), transparent);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }
  .caveat {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.9rem;
    text-align: center;
  }
  .caveat :global(p) {
    margin: 0;
  }
</style>
