---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
import type { RecordingContent } from "../content/schema";
import "asciinema-player/dist/bundle/asciinema-player.css";
interface Props {
  content: RecordingContent;
}
const { content } = Astro.props;
---

<section class="demo-section section" id="demo" aria-labelledby="demo-title">
  <div class="wrap">
    <div class="demo-heading section-heading">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h2 id="demo-title">{content.title}</h2>
        <div class="section-intro">
          <slot name="intro" />
        </div>
      </div>
      <span class="duration">
        {content.duration}
        <span aria-hidden="true"> / </span>ASCIINEMA
      </span>
    </div>
    <div class="terminal-shell">
      <div class="terminal-bar" aria-hidden="true">
        <span class="dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>{content.terminalLabel}</span>
        <span class="terminal-indicator">RECORDED SESSION</span>
      </div>
      <div
        data-recording
        data-src={content.src}
        data-cols={content.cols}
        data-rows={content.rows}
        data-markers={JSON.stringify(content.markers)}
        aria-label={content.title}
      >
        <noscript>
          <p class="fallback">{content.fallback}</p>
        </noscript>
      </div>
    </div>
    <div class="demo-caption">
      <div>
        <slot name="caption" />
      </div>
      <a href={content.src} download>
        {content.downloadLabel}
        <span aria-hidden="true"> ↓</span>
      </a>
    </div>
  </div>
</section>
<script>
  import { create, type Marker } from "asciinema-player";
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const element = entry.target as HTMLElement;
        const source = element.dataset.src;
        if (source) {
          create(source, element, {
            cols: Number(element.dataset.cols),
            rows: Number(element.dataset.rows),
            fit: "width",
            poster: "npt:12",
            autoplay: !reducedMotion.matches,
            loop: !reducedMotion.matches,
            markers: JSON.parse(element.dataset.markers || "[]") as Marker[],
          });
        }
        observer.unobserve(element);
      }
    },
    { threshold: 0.15 },
  );
  document
    .querySelectorAll<HTMLElement>("[data-recording]")
    .forEach((element) => observer.observe(element));
</script>
<style>
  .demo-section {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .demo-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .duration {
    padding-top: 0.1rem;
    white-space: nowrap;
    color: var(--muted);
    font: 0.7rem var(--font-mono);
  }
  .terminal-shell {
    background: #111111;
    color: #ccc;
    border: 1px solid #343b35;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 18px 50px #17231c18;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    background: #202621;
    border-bottom: 1px solid #353c36;
    color: #bfc7c0;
    font: 0.7rem var(--font-mono);
  }
  .dots {
    display: flex;
    gap: 0.35rem;
  }
  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6a766c;
  }
  .terminal-indicator {
    font-size: 0.6rem;
    letter-spacing: 0.07em;
  }
  [data-recording] {
    aspect-ratio: 1.62;
  }
  [data-recording]:has(.ap-wrapper) {
    aspect-ratio: auto;
  }
  .fallback {
    padding: 2rem;
    color: #ccc;
  }
  .demo-caption {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .demo-caption > div {
    max-width: 43rem;
  }
  .demo-caption a {
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    [data-recording] :global(.ap-wrapper:not(:fullscreen) .ap-player) {
      height: auto !important;
    }
    [data-recording] :global(.ap-control-bar) {
      opacity: 1;
    }
    [data-recording] :global(.ap-wrapper:not(:fullscreen) .ap-control-bar) {
      position: relative;
      height: 44px;
    }
    [data-recording] :global(.ap-wrapper:not(:fullscreen) .ap-button) {
      box-sizing: border-box;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      height: 44px;
    }
    [data-recording] :global(.ap-wrapper:not(:fullscreen) .ap-gutter) {
      top: 21px;
    }
    [data-recording] :global(.ap-wrapper:not(:fullscreen) .ap-marker) {
      top: 19px;
      bottom: 18px;
    }
    [data-recording] :global(.ap-kbd-button) {
      display: none;
    }
  }
  @media (hover: none) {
    [data-recording] :global(.ap-tooltip) {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .demo-heading,
    .demo-caption {
      flex-direction: column;
      gap: 1rem;
    }
    .terminal-indicator {
      display: none;
    }
    .terminal-bar {
      font-size: 0.65rem;
    }
  }
</style>
