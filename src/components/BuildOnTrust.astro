---
// ── Build on trust ────────────────────────────────────
import { landing } from "../content/schema";
import { Content as Intro } from "../content/prose/trust-intro.md";
import { Content as Caption } from "../content/prose/trust-caption.md";
import Steps from "./Steps.astro";

const { trust } = landing;
---

<section class="section">
  <h2 class="h">{trust.heading}</h2>
  <div class="section-desc trust-intro">
    <Intro />
  </div>
  <Steps steps={trust.steps} />
  <div class="illus">
    <Caption />
  </div>
</section>

<style>
  .trust-intro {
    text-align: center;
    margin-bottom: 1.75rem;
  }
</style>
