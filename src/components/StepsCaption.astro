---
// ── Steps + caption: heading + intro slot + numbered steps + a caption slot ──
// Intro + caption come in via named slots so the page owns the wording.
import type { StepsCaptionContent } from "../content/schema";
import Steps from "./Steps.astro";

interface Props {
  content: StepsCaptionContent;
  // Optional anchor id so a page can target this section (e.g. the bottom nav).
  id?: string;
}

const { content, id } = Astro.props;
---

<section class="section" id={id}>
  <h2 class="h">{content.heading}</h2>
  <div class="section-desc trust-intro">
    <slot name="intro" />
  </div>
  <Steps steps={content.steps} />
  <div class="illus">
    <slot name="caption" />
  </div>
</section>

<style>
  .trust-intro {
    text-align: center;
    margin-bottom: 1.75rem;
  }
</style>
