---
// ── Card grid: heading + intro slot + a 3-up grid of dot/name/body cards ──
// Prose intro comes in via the "intro" slot so the page owns the wording.
import type { CardGridContent } from "../content/schema";

interface Props {
  content: CardGridContent;
}

const { content } = Astro.props;
---

<section class="section">
  <h2 class="h">{content.heading}</h2>
  <div class="section-desc problem-intro">
    <slot name="intro" />
  </div>
  <div class="grid grid-3">
    {content.cards.map((card) => (
      <div class:list={["pcard", { win: card.win }]}>
        <div class="name">
          <span class={`dot d-${card.dot}`} />
          {card.name}
        </div>
        <p>{card.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .problem-intro {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .pcard {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.4rem;
  }
  .pcard.win {
    border-color: #2c5a2e;
    background: linear-gradient(180deg, rgba(63, 185, 80, 0.06), transparent);
  }
  .pcard .name {
    font-weight: 700;
    color: #fff;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pcard .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .pcard p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }
  .d-gray {
    background: var(--muted);
  }
  .d-gold {
    background: var(--gold);
  }
  .d-green {
    background: var(--green);
  }
</style>
