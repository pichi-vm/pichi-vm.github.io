---
// ── Try it ────────────────────────────────────────────
import { landing } from "../content/schema";
import { Content as Caption } from "../content/prose/try-it-caption.md";

const { tryIt } = landing;
---

<section class="section">
  <div class="section-title">{tryIt.title}</div>
  <div class="term">
    <div class="term-bar" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <pre>{tryIt.terminal.map((line, i) => (
      <Fragment>
        {i > 0 && "\n"}
        {line.kind === "cmd" && (<Fragment><span class="p">$</span> <span class="c">{line.text}</span></Fragment>)}
        {line.kind === "out" && <span class="o">{line.text}</span>}
        {/* kind: "gap" renders as just the newline above */}
      </Fragment>
    ))}</pre>
  </div>
  <div class="illus">
    <Caption />
  </div>
</section>

<style>
  .term {
    background: #0a0d12;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    max-width: 40rem;
    margin: 0 auto;
  }
  .term-bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .term-bar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--border);
  }
  .term pre {
    margin: 0;
    padding: 1.1rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.9;
    overflow-x: auto;
  }
  .term .p {
    color: var(--green);
  }
  .term .c {
    color: #fff;
  }
  .term .o {
    color: var(--muted);
  }
  /* <Caption> renders a <p>; keep it inline-friendly. */
  .illus :global(p) {
    margin: 0;
  }
</style>
