---
// ── Hero ──────────────────────────────────────────────
// Sub-line comes in via the "sub" slot so the page owns the wording.
import type { HeroContent } from "../content/schema";

interface Props {
  hero: HeroContent;
}

const { hero } = Astro.props;
---

<header class="hero">
  <div class="hero-head">
    <img
      class="hero-mascot"
      src="/pichi-logo.png"
      width="247"
      height="260"
      alt={hero.logoAlt}
    />
    <div class="hero-headings">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1 set:html={hero.title} />
    </div>
  </div>
  <div class="sub">
    <slot name="sub" />
  </div>
  {hero.steps && (
    <ol class="hero-steps grid grid-3">
      {hero.steps.map((step) => (
        <li class="hero-step">
          <span class="hero-step-n">{step.n}</span>
          <span class="hero-step-body">{step.body}</span>
        </li>
      ))}
    </ol>
  )}
  {hero.commands && (
    <div class="hero-term" aria-label="Example commands">
      <div class="hero-term-bar" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <pre>{hero.commands.map((cmd, i) => (
        <Fragment>
          {i > 0 && "\n"}
          <span class="p">$</span> <span class="c">{cmd}</span>
        </Fragment>
      ))}</pre>
    </div>
  )}
  {hero.commands && Astro.slots.has("termNote") && (
    <div class="hero-term-note">
      <slot name="termNote" />
    </div>
  )}
  {hero.stats && (
    <dl class="hero-stats">
      {hero.stats.map((stat) => (
        <div class="stat">
          <dt>{stat.value}</dt>
          <dd>{stat.label}</dd>
        </div>
      ))}
    </dl>
  )}
</header>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 0;
    /* Matches the 4rem gap between every other section (.section margin-bottom).
       The old bottom padding + margin doubled the gap; it existed to clear the
       bottom border (now removed), so it's dropped. */
    margin-bottom: 4rem;
  }
  /* Shrink-wrap around the headings and center that on the page, so the title
     (and the eyebrow) stay aligned with the sub-line / terminal / CTAs below.
     The mascot is positioned relative to THIS block — out of flow, so it frames
     the title without shoving it off page-center. */
  .hero-head {
    position: relative;
    display: inline-block;
    margin-bottom: 1.5rem;
    padding-top: 0.5rem;
  }
  .hero-headings {
    text-align: center;
  }
  /* The mascot is black line-art on transparency; invert() flips it to white so
     it reads on the dark background, then dim it so the title stays dominant.
     Anchored to the headings' left edge and shifted left by ~80% of its own
     width, so only ~20% tucks behind the title — a constant overlap at any
     width (it moves with the centered block, not the column edge). */
  .hero-mascot {
    position: absolute;
    top: 50%;
    left: 0;
    height: 10rem;
    width: auto;
    transform: translate(-80%, -50%);
    filter: invert(1);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }
  .eyebrow {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    position: relative;
    z-index: 1;
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.15;
    color: #fff;
    margin-bottom: 0;
    letter-spacing: -0.02em;
  }
  .hero .sub {
    font-size: 1.15rem;
    color: var(--fg);
    max-width: 38rem;
    margin: 0 auto 2rem;
  }
  /* Compact command preview — the product, above the fold. A trimmed cousin of
     the full "How it works" terminal below (no output lines, tighter). */
  .hero-term {
    max-width: 30rem;
    margin: 0 auto 2rem;
    text-align: left;
    background: #0a0d12;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .hero-term-bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .hero-term-bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--border);
  }
  .hero-term pre {
    margin: 0;
    padding: 0.9rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.8;
    overflow-x: auto;
  }
  .hero-term .p {
    color: var(--green);
  }
  .hero-term .c {
    color: #fff;
  }
  /* Small muted caption under the command preview — same treatment as the
     comparison caveat. Pulled up under the terminal (which has a 2rem bottom
     margin) so it reads as the terminal's footnote. */
  .hero-term-note {
    margin: -1.4rem auto 2rem;
    max-width: 30rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .hero-term-note :global(p) {
    margin: 0;
  }
  /* Numbered step row above the terminal: a label + one line per command, no
     surface cards. Left-aligned text, constrained to the terminal's width so it
     lines up with the example below it. */
  .hero-steps {
    list-style: none;
    max-width: 30rem;
    margin: 0 auto 2rem;
    padding: 0;
    text-align: left;
  }
  .hero-step {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .hero-step-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
  }
  .hero-step-body {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }
  /* Stat strip — framed as design targets in the labels, not measured results.
     Closes out the hero under the terminal + steps, set off by a top divider. */
  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 2.25rem auto 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    max-width: 32rem;
  }
  .hero-stats .stat {
    text-align: center;
  }
  .hero-stats dt {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green);
    line-height: 1.2;
  }
  .hero-stats dd {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 680px) {
    .hero-stats {
      gap: 1.75rem;
    }
    /* Not enough width to flank on mobile — put the mascot back in flow, above
       and centered over the title, instead of tucked to its left. */
    .hero-head {
      padding-top: 6.75rem;
    }
    .hero-mascot {
      position: absolute;
      top: 0;
      left: 50%;
      height: 5.5rem;
      transform: translateX(-50%);
    }
  }
</style>
