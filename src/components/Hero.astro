---
// SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
// SPDX-License-Identifier: Apache-2.0
import type { HeroContent } from "../content/schema";
interface Props {
  content: HeroContent;
}
const { content } = Astro.props;
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1 id="hero-title">
      {content.title}
      <br />
      <span>{content.accent}</span>
    </h1>
    <div class="hero-description">
      <slot name="intro" />
    </div>
    <div class="actions">
      <a class="btn" href={content.primary.href}>
        <span aria-hidden="true">▶</span>
        {content.primary.label}
      </a>
      <a class="text-link" href={content.secondary.href}>
        {content.secondary.label}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <figure class="mascot">
    <div class="mascot-orbit">
      <img
        src="/pichi-logo.svg"
        width="420"
        height="420"
        alt={content.logoAlt}
        fetchpriority="high"
      />
    </div>
  </figure>
</section>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .hero .eyebrow {
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(2.8rem, 5.2vw, 4.7rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
    font-weight: 700;
  }
  h1 span {
    color: var(--accent);
  }
  .hero-description {
    margin-top: 1.6rem;
    max-width: 33rem;
    font-size: 1.1rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .mascot {
    margin: 0;
    text-align: center;
  }
  .mascot-orbit {
    position: relative;
    isolation: isolate;
  }
  .mascot-orbit::before {
    content: "";
    position: absolute;
    inset: 10% 0;
    border-radius: 50%;
    background: #ece6d7;
    z-index: -1;
  }
  .mascot img {
    display: block;
    width: 100%;
    transform: rotate(-5deg);
  }
  @media (max-width: 900px) {
    .hero {
      gap: 1rem;
      grid-template-columns: 1.65fr 1fr;
    }
    h1 {
      font-size: clamp(2.5rem, 5.4vw, 4.7rem);
    }
  }
  @media (max-width: 650px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 2.5rem;
      gap: 2rem;
    }
    h1 {
      font-size: clamp(2.25rem, 9vw, 3.6rem);
    }
    .mascot {
      max-width: 160px;
      margin-inline: auto;
    }
    .hero-description {
      font-size: 1rem;
    }
    .actions {
      gap: 1.25rem;
    }
  }
</style>
