---
// ── Hero ──────────────────────────────────────────────
// Sub-line comes in via the "sub" slot so the page owns the wording.
import type { HeroContent, CtaContent } from "../content/schema";
import Ctas from "./Ctas.astro";

interface Props {
  hero: HeroContent;
  ctas: CtaContent[];
}

const { hero, ctas } = Astro.props;
---

<header class="hero">
  <img
    class="hero-logo"
    src="/pichi-logo.png"
    width="112"
    height="112"
    alt={hero.logoAlt}
  />
  <div class="eyebrow">{hero.eyebrow}</div>
  <h1 set:html={hero.title} />
  <div class="sub">
    <slot name="sub" />
  </div>
  <Ctas ctas={ctas} />
</header>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3.5rem;
  }
  .hero-logo {
    width: 112px;
    height: 112px;
    margin: 0 auto 1.5rem;
    display: block;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.75rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.15;
    color: #fff;
    margin-bottom: 1.1rem;
    letter-spacing: -0.02em;
  }
  .hero .sub {
    font-size: 1.15rem;
    color: var(--fg);
    max-width: 38rem;
    margin: 0 auto 2rem;
  }
</style>
