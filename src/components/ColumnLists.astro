---
// ── Column lists: title + a 2-up row of heading/bulleted-list columns ──
import type { ColumnListsContent } from "../content/schema";

interface Props {
  content: ColumnListsContent;
}

const { content } = Astro.props;
---

<section class="section">
  <div class="section-title">{content.title}</div>
  <div class="grid grid-2">
    {content.columns.map((col) => (
      <div class="whocol">
        <h3>{col.heading}</h3>
        <ul>
          {col.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .whocol {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.4rem 1.5rem;
  }
  .whocol h3 {
    font-size: 1rem;
    color: #fff;
    margin-bottom: 0.6rem;
  }
  .whocol ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .whocol li {
    font-size: 0.9rem;
    color: var(--muted);
    padding-left: 1.2rem;
    position: relative;
    margin-bottom: 0.4rem;
  }
  .whocol li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
