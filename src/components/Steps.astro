---
// Renders a row of numbered steps. Used by StepsCaption (Build on trust).
// Each step: { n, heading, body }. Styling lives in the global stylesheet.
import type { StepContent } from "../content/schema";

interface Props {
  steps: StepContent[];
}

const { steps } = Astro.props;
---

<div class="steps grid grid-3">
  {steps.map((step) => (
    <div class="step">
      <div class="n">{step.n}</div>
      <h3>{step.heading}</h3>
      <p>{step.body}</p>
    </div>
  ))}
</div>
