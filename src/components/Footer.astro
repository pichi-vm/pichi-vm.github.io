---
// ── Footer ────────────────────────────────────────────
import { landing } from "../content/schema";
import Ctas from "./Ctas.astro";

const { footer, ctas } = landing;
---

<footer class="foot">
  <Ctas ctas={ctas} />
  <p class="foot-meta">
    {footer.meta.map((link) => (
      <Fragment>
        <a href={link.href}>{link.label}</a> ·{" "}
      </Fragment>
    ))}
    {footer.license}
  </p>
  <span class="badge">{footer.badge}</span>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    padding-top: 2.5rem;
    text-align: center;
  }
  .foot .cta-row {
    margin-bottom: 1.5rem;
  }
  .foot-meta {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .foot-meta a {
    text-decoration: none;
  }
  .foot-meta a:hover {
    text-decoration: underline;
  }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold);
    border: 1px solid #5a4620;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-top: 1rem;
  }
</style>
